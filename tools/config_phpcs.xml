<?xml version="1.0"?>
<ruleset name="LegacyPHP85Compatibility ">
    <description>Find code to fix before upgrading to PHP 8.5.</description>
    <config name="testVersion" value="8.5"/>
    <rule ref="PHPCompatibility"/>
    <arg name="extensions" value="php,inc"/>
    <file>../index.php</file>
    <file>../app</file>
    <file>../lib</file>
    <file>../modules</file>
    <file>../public</file>
    <exclude-pattern>*/lib/Classes/*</exclude-pattern>
    <exclude-pattern>*/lib/legacy-packages/*</exclude-pattern>
    <exclude-pattern>*/lib/JSPacker/*</exclude-pattern>
    <exclude-pattern>*/third-party/*</exclude-pattern>
    <exclude-pattern>*/third-party/Classes/*</exclude-pattern>
</ruleset>